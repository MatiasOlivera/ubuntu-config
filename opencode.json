{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-grafana==2.2.0",
          "--enabled-tools=search,datasource,prometheus,loki,alerting,dashboard,tempo"
        ],
        "environment": {
          "GRAFANA_URL": "{env:GRAFANA_URL}",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "setup/*": "deny",
      "./setup/*": "deny",
      "bash setup/*": "deny",
      "bash ./setup/*": "deny",
      "sh setup/*": "deny",
      "sh ./setup/*": "deny",
      "source setup/*": "deny",
      "source ./setup/*": "deny",
      "*setup/*.sh*": "deny",
      "sudo *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "snap *": "deny",
      "chsh*": "deny",
      "bash -n setup/*.sh": "allow",
      "bash -n setup/**/*.sh": "allow",
      "bash -n ./setup/*.sh": "allow",
      "bash -n ./setup/**/*.sh": "allow",
      "bash -n */setup/*.sh": "allow",
      "bash -n */setup/**/*.sh": "allow",
      "shellcheck *setup/*.sh*": "allow",
      "bash tests/**/*-test.sh": "allow",
      "bash ./tests/**/*-test.sh": "allow",
      "cat *setup/*.sh*": "allow",
      "grep *setup/*.sh*": "allow",
      "head *setup/*.sh*": "allow",
      "tail *setup/*.sh*": "allow",
      "wc *setup/*.sh*": "allow"
    }
  }
}
