{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@dietrichgebert/ponytail"],
  "lsp": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B",
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder",
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen3.5:2b": {
          "name": "Qwen 3.5 2B",
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT_FOR_CODING_AGENTS}"
      }
    }
  }
}
