{
  "uid": "e2e-runs",
  "title": "E2E runs",
  "description": "Per-app step spans and timing from an end-to-end verification run.",
  "tags": ["e2e", "ubuntu-config"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Step spans (replayed records)",
      "description": "One row per step span, replayed from spans.jsonl into Loki. Available even when the stack starts after the run.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{exporter=\"OTLP\"} | json | attributes_log_file_name=\"spans.jsonl\" | line_format \"{{.attributes_name}} | {{.attributes_phase}} | {{.attributes_status}} | {{.attributes_duration_ms}}ms | {{.attributes_run_id}}\"",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Step duration by app (records)",
      "description": "Average recorded step duration in milliseconds, grouped by step label.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" },
          "links": [
            {
              "title": "Explore this app's spans",
              "targetBlank": true,
              "url": "/explore?schemaVersion=1&panes={\"map\":{\"datasource\":\"loki\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"loki\",\"uid\":\"loki\"},\"expr\":\"{exporter=\\\"OTLP\\\"} | json | attributes_log_file_name=\\\"spans.jsonl\\\" | attributes_name=\\\"${__field.labels.attributes_name}\\\"\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}&orgId=1"
            }
          ]
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (attributes_name) (avg_over_time({exporter=\"OTLP\"} | json | attributes_log_file_name=\"spans.jsonl\" | unwrap attributes_duration_ms [5m]))",
          "legendFormat": "{{attributes_name}}",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Steps by app (live)",
      "description": "Step spans counted from trace-derived metrics; populated when the stack runs during the e2e run.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (increase(traces_spanmetrics_calls_total[5m]))",
          "legendFormat": "{{app}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 step latency by app (live)",
      "description": "95th percentile step duration in seconds from trace-derived metrics.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, app) (rate(traces_spanmetrics_latency_bucket[5m])))",
          "legendFormat": "{{app}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failed steps by app (live)",
      "description": "Steps with an error status in trace-derived metrics; populated when the stack runs during the run.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (increase(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{app}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed steps by app (records)",
      "description": "Failed steps from replayed records; available even when the stack starts after the run.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" },
          "links": [
            {
              "title": "Explore this app's failures",
              "targetBlank": true,
              "url": "/explore?schemaVersion=1&panes={\"map\":{\"datasource\":\"loki\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"loki\",\"uid\":\"loki\"},\"expr\":\"{exporter=\\\"OTLP\\\"} | json | attributes_log_file_name=\\\"spans.jsonl\\\" | attributes_status=\\\"error\\\" | attributes_name=\\\"${__field.labels.attributes_name}\\\"\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}&orgId=1"
            }
          ]
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (attributes_name) (count_over_time({exporter=\"OTLP\"} | json | attributes_log_file_name=\"spans.jsonl\" | attributes_status=\"error\" [5m]))",
          "legendFormat": "{{attributes_name}}",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Step duration by run (records)",
      "description": "Average step duration per run id, from replayed records, for comparing runs over time.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" },
          "links": [
            {
              "title": "Explore this run's spans",
              "targetBlank": true,
              "url": "/explore?schemaVersion=1&panes={\"map\":{\"datasource\":\"loki\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"loki\",\"uid\":\"loki\"},\"expr\":\"{exporter=\\\"OTLP\\\"} | json | attributes_log_file_name=\\\"spans.jsonl\\\" | attributes_run_id=\\\"${__field.labels.attributes_run_id}\\\"\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}&orgId=1"
            }
          ]
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (attributes_run_id) (avg_over_time({exporter=\"OTLP\"} | json | attributes_log_file_name=\"spans.jsonl\" | unwrap attributes_duration_ms [5m]))",
          "legendFormat": "{{attributes_run_id}}",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Slowest steps (records)",
      "description": "Top five slowest step labels by average recorded duration.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "displayMode": "gradient", "orientation": "horizontal", "showValue": "always" }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showValue": "always",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, avg by (attributes_name) (avg_over_time({exporter=\"OTLP\"} | json | attributes_log_file_name=\"spans.jsonl\" | unwrap attributes_duration_ms [5m])))",
          "legendFormat": "{{attributes_name}}",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    }
  ]
}
