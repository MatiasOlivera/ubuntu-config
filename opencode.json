{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "setup/*": "deny",
      "./setup/*": "deny",
      "bash setup/*": "deny",
      "bash ./setup/*": "deny",
      "sh setup/*": "deny",
      "sh ./setup/*": "deny",
      "source setup/*": "deny",
      "source ./setup/*": "deny",
      "*setup/*.sh*": "deny",
      "sudo *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "snap *": "deny",
      "chsh*": "deny",
      "bash -n setup/*.sh": "allow",
      "bash -n setup/**/*.sh": "allow",
      "bash -n ./setup/*.sh": "allow",
      "bash -n ./setup/**/*.sh": "allow",
      "bash -n */setup/*.sh": "allow",
      "bash -n */setup/**/*.sh": "allow",
      "shellcheck *setup/*.sh*": "allow",
      "cat *setup/*.sh*": "allow",
      "grep *setup/*.sh*": "allow",
      "head *setup/*.sh*": "allow",
      "tail *setup/*.sh*": "allow",
      "wc *setup/*.sh*": "allow"
    }
  }
}
